{
  "name": "ductective",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AI diagnostic assistant for HVAC technicians — Phase 1 rails",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "verify": "node --env-file=.env scripts/verify-connection.mjs",
    "sync-env": "node scripts/sync-app-env.mjs",
    "app": "npm run sync-env && npm --prefix app run web",
    "verify:sessions": "node --env-file=.env scripts/verify-sessions.mjs",
    "verify:stage5": "node --env-file=.env tests/run-all.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0"
  }
}
