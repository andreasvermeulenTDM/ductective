{
  "name": "ductective",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AI diagnostic assistant for HVAC technicians — Phase 1 rails",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "build": "npm --prefix app run typecheck",
    "test": "node --test",
    "verify": "node --env-file=.env scripts/verify-connection.mjs",
    "verify:bundle": "node --env-file-if-exists=.env scripts/verify-bundle.mjs",
    "sync-env": "node scripts/sync-app-env.mjs",
    "app": "npm run sync-env && npm --prefix app run web",
    "verify:sessions": "node --env-file=.env scripts/verify-sessions.mjs",
    "verify:auth": "node --env-file=.env scripts/verify-auth-config.mjs",
    "verify:accounts": "node --env-file=.env scripts/verify-accounts.mjs",
    "measure:linking": "node --env-file=.env scripts/measure-auth-linking.mjs",
    "measure:authdelete": "node --env-file=.env scripts/measure-auth-delete.mjs",
    "verify:duplicates": "node --env-file=.env scripts/find-duplicates.mjs",
    "verify:stage5": "node --env-file=.env tests/run-all.mjs",
    "density": "node tests/density-baseline.mjs",
    "verify:secrets": "node --env-file-if-exists=.env scripts/verify-secrets.mjs",
    "ingest:reconcile": "node ingest/reconcile.mjs",
    "ingest": "node --env-file=.env ingest/run.mjs",
    "ingest:parse": "node ingest/parse.mjs",
    "ingest:smoke": "node --env-file=.env ingest/smoke.mjs",
    "ingest:smoke:scoped": "node --env-file=.env ingest/smoke-scoped.mjs",
    "serve": "node --env-file=.env scripts/serve.mjs",
    "eval:score": "node eval/score.mjs",
    "metrics": "node --env-file-if-exists=.env scripts/summarize-metrics.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "jpeg-js": "^0.4.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.66.0"
  }
}
