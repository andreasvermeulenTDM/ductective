# Source corpus — 209 MB of OEM PDFs. Never track these.
# data/manifest.csv is the tracked artifact; it carries the source URLs, so the
# corpus is reproducible from a clean clone.
HVAC Data/
ingest/sources/

# Belt and braces — no PDF anywhere in this repo is intended to be tracked.
*.pdf

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies
node_modules/
.pnp
.pnp.js

# Expo / React Native
.expo/
.expo-shared/
dist/
web-build/
*.jks
*.p8
*.p12
*.mobileprovision
*.orig.*

# Supabase local stack
supabase/.branches/
supabase/.temp/

# Build output
build/
.next/
out/
*.tsbuildinfo

# Editor / OS
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Claude Code local settings
.claude/settings.local.json

# OneDrive keeps re-syncing the pre-restructure pipeline path; the live agents
# are in .claude/agents/.
agent-pipeline/

# Generated from the root .env by scripts/sync-app-env.mjs — never commit.
app/.env

# Stage 5 run output. The report is a deliverable only once it is copied into
# .pipeline/05-test-report.md; last-run.json is local state for round-over-round
# regression comparison. Neither belongs in a diff.
tests/last-run.md
tests/last-run.json

# M12 spike — regenerable output and the pdftotext cache
spike/m12/.cache/
spike/m12/out/

# Parsed-page cache — regenerable, and derived from the gitignored corpus
ingest/.cache/
